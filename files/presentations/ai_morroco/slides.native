  Meta
    { unMeta =
        fromList
          [ ( "bibliography" , MetaInlines [ Str "slides.bib" ] )
          , ( "header-includes"
            , MetaList
                [ MetaBlocks
                    [ RawBlock
                        (Format "native")
                        "<style>\n#title-slide .title {\n  font-size: 2em;\n}\n</style>\n"
                    ]
                ]
            )
          , ( "title"
            , MetaInlines
                [ Str "Geometric"
                , Space
                , Str "deep"
                , Space
                , Str "learning:"
                , Space
                , Str "from"
                , Space
                , Str "theory"
                , Space
                , Str "to"
                , Space
                , Str "practice"
                ]
            )
          ]
    }
