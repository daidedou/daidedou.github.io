# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json
.vscode

# Python bytecode
__pycache__/
*.py[cod]

# Generated CV content and LaTeX build products
cv/generated/academic.tex
cv/*.aux
cv/*.fdb_latexmk
cv/*.fls
cv/*.log
cv/*.out
cv/*.synctex.gz
cv/*.xdv
cv/cv.pdf
files/cv.pdf
